# Production, NON-secret configuration (committed). v2 runs as a version of switch-proj's App
# Engine `default` service, next to legacy's (docs/06-production.md). Secrets come from Secret
# Manager (`switch-server-env` in switch-proj, pinned by SECRETS_VERSION, added with
# `pnpm production:secret`). Values mirror legacy configs.js.
LOG_LEVEL=info
PARSE_APP_NAME=Switch
PARSE_APP_ID=switchApp
PARSE_PUBLIC_SERVER_URL=https://api.switchfood.net
# OD-6: legacy accepted the master key from any IP. Keep it open while legacy's version exists:
# its cloud code calls api.switchfood.net (= v2 after the switch) with the master key, from App
# Engine's changing addresses. Tighten after legacy is deleted, once the Parse Dashboard
# operators' IPs are known (docs/06-production.md, "Decommission legacy").
MASTER_KEY_IPS=0.0.0.0/0,::/0
# App Engine's proxy reaches the server from loopback: the client address is this header.
CLIENT_IP_HEADER=x-appengine-user-ip
# TRUST_PROXY is measured on staging (P4-3) before it is set here.
GOOGLE_CLIENT_ID=121610801380-ouhdb4ogsuoervpqaq407fhn4ccobcp0.apps.googleusercontent.com
FACEBOOK_APP_IDS=3475273352569710
APPLE_CLIENT_IDS=com.switchapp.food,com.switchapp.driver,com.switchapp.manager
MAIL_DRIVER=sendgrid
MAIL_FROM=no-reply@switchfood.net
PUSH_DRIVER=fcm
REALTIME_DRIVER=pusher
# The production Pusher app: the one whose key switch-ops (NEXT_PUBLIC_PUSHER_KEY,
# b4cb8ea88897dba8ec3b) and the driver app subscribe with. Pusher → Channels → that app → App Keys.
# Its secret goes in the Secret Manager secret (PUSHER_SECRET). Needed by D-19 (driver new-order
# realtime) and D-23 (driver declines live in ops). The deploy preflight refuses these blank.
# (Legacy configs.js in the repo has them blank, so legacy's own Pusher triggers fail.)
PUSHER_APP_ID=2196095
PUSHER_KEY=337b658e660ec3f09bd3
PUSHER_CLUSTER=eu
SMS_DRIVER=sms-algerie
SMS_ENDPOINT=https://es3.sms-algerie.com/api/json
SMS_MESSAGE_TEMPLATE=Your Switch code is: %CODE%
SMS_RETRIEVER_HASH_FOOD=euK5ZNhbO6h
SMS_RETRIEVER_HASH_DRIVER=oleQE6OQqru
SMS_RETRIEVER_HASH_MANAGER=KtjJ1xHgVtK
DISTANCE_DRIVER=google
FILES_DRIVER=s3
S3_BUCKET=switchfood
S3_BASE_URL=https://switchfood.fra1.cdn.digitaloceanspaces.com
S3_ENDPOINT=https://fra1.digitaloceanspaces.com
S3_REGION=fra1
S3_FORCE_PATH_STYLE=false
S3_CACHE_CONTROL=public, max-age=31536000
ADMIN_EMAIL=support@switchfood.net
ADMIN_APP_TYPE=staff
ADMIN_STAFF_TYPE=Admin
STAFF_ROLE_NAME=Staff
# This will be changed to true after the migration.
DISPATCH_WORKER_ENABLED=false
AGENDA_COLLECTION=agendaJobs
AGENDA_PROCESS_EVERY_MS=5000
AGENDA_LOCK_LIFETIME_MS=600000
SECRETS_SOURCE=gcp
SECRETS_PROJECT=switch-proj
SECRETS_NAME=switch-server-env
# Boot refuses without it: the pinned version number, written here by `pnpm production:secret`.
SECRETS_VERSION=
