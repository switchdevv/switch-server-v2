# switch-server-v2 — every variable the server reads (src/config/env.ts is the source of truth).
# [S] = secret: Secret Manager in staging/production, fake/generated locally. Never commit one.
# "legacy:" = where the value lives in switch-server/configs.js today.
#
# Copy to .env.local for `pnpm dev`. The prod-leak guard refuses to boot local/test/staging/
# rehearsal with any production value (src/config/guards.ts).

# --- Core -------------------------------------------------------------------------------------
APP_ENV=local                       # local | test | staging | rehearsal | production
PORT=1337                           # App Engine sets it in production
LOG_LEVEL=debug                     # fatal | error | warn | info | debug | trace | silent
PARSE_APP_NAME=Switch               # legacy: parse.appName
PARSE_APP_ID=switchApp              # legacy: parse.appId. Public, compiled into every client.
PARSE_MASTER_KEY=                   # [S] legacy: parse.masterKey. Locally: any random string.
PARSE_MAINTENANCE_KEY=              # [S] new in Parse 6. Random.
DATABASE_URI=mongodb://localhost:27018/switch_local?directConnection=true   # [S] legacy: parse.databaseURI. directConnection: the replica set advertises the container-internal localhost:27017
PARSE_PUBLIC_SERVER_URL=http://localhost:1337   # legacy: parse.publicServerURL (prod: https://api.switchfood.net)
# PARSE_SERVER_URL=                 # internal loopback; defaults to http://localhost:$PORT
MASTER_KEY_IPS=0.0.0.0/0,::/0       # open only in local/test. Prod: OD-6.
# CLIENT_IP_HEADER=x-appengine-user-ip  # App Engine: req.ip for MASTER_KEY_IPS (staging/prod)
# TRUST_PROXY=                      # App Engine front-end hops, measured in staging (P4-3)
# DB_MAX_POOL_SIZE=
# DB_MAX_TIME_MS=
# DB_SERVER_SELECTION_TIMEOUT_MS=
DB_ENABLE_SCHEMA_HOOKS=true         # needs a replica set (Atlas is one; local Mongo runs rs0)

# --- Auth adapters (public identifiers) ---------------------------------------------------------
GOOGLE_CLIENT_ID=                   # legacy: google.clientID (= the apps' webClientID)
FACEBOOK_APP_IDS=                   # legacy: facebook.appId (comma-separated)
APPLE_CLIENT_IDS=com.switchapp.food,com.switchapp.driver,com.switchapp.manager   # D-3

# --- Email (verification + password reset) ------------------------------------------------------
MAIL_DRIVER=fake                    # fake | sendgrid | allowlist
MAIL_FROM=no-reply@switchfood.net   # legacy: sendgrid.fromAddress
SENDGRID_API_KEY=                   # [S] legacy: sendgrid.apiKey
MAIL_ALLOWLIST=                     # staging recipients (allowlist driver)

# --- Push (FCM) ---------------------------------------------------------------------------------
PUSH_DRIVER=fake                    # fake | fcm | allowlist
FIREBASE_SERVICE_ACCOUNT=           # [S] the service-account JSON on one line. legacy: firebase
PUSH_TOKEN_ALLOWLIST=               # staging device tokens (OD-7)

# --- Realtime (Pusher) --------------------------------------------------------------------------
REALTIME_DRIVER=fake                # fake | pusher
PUSHER_APP_ID=                      # legacy: pusher.appId
PUSHER_KEY=                         # legacy: pusher.key (shipped in the driver app)
PUSHER_SECRET=                      # [S] legacy: pusher.secret
PUSHER_CLUSTER=eu                   # legacy: pusher.cluster

# --- SMS (OTP) ----------------------------------------------------------------------------------
SMS_DRIVER=fake                     # fake | sms-algerie | allowlist
SMS_ENDPOINT=https://es3.sms-algerie.com/api/json   # legacy: sms.endpoint
SMS_API_KEY=                        # [S] legacy: sms.apiKey
SMS_USER_KEY=                       # [S] legacy: sms.userKey
SMS_MESSAGE_TEMPLATE=Your Switch code is: %CODE%   # legacy: sms.message
SMS_RETRIEVER_HASH_FOOD=            # legacy: sms.smsRetrieverHash.food (Android SMS Retriever)
SMS_RETRIEVER_HASH_DRIVER=
SMS_RETRIEVER_HASH_MANAGER=
SMS_PHONE_ALLOWLIST=                # staging numbers (allowlist driver)

# --- Distance Matrix ----------------------------------------------------------------------------
DISTANCE_DRIVER=fake                # fake | google
GOOGLE_MAPS_API_KEY=                # [S] legacy: google.mapKey

# --- Files --------------------------------------------------------------------------------------
FILES_DRIVER=gridfs                 # s3 (SeaweedFS locally, Spaces in staging/prod) | gridfs (tests, quick local)
S3_BUCKET=switchfood-local          # legacy: spaces.bucket (prod: switchfood)
S3_BASE_URL=http://localhost:9000/switchfood-local   # legacy: spaces.baseUrl
S3_ENDPOINT=http://localhost:9000   # legacy: spaces.s3overrides.endpoint (prod: https://fra1.digitaloceanspaces.com)
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true            # local SeaweedFS: true; Spaces: false
S3_CACHE_CONTROL=public, max-age=31536000   # legacy: spaces.globalCacheControl
S3_ACCESS_KEY_ID=                   # [S] legacy: spaces.s3overrides.accessKeyId (any value locally: the
                                    # local S3 has no identities, so signatures aren't checked)
S3_SECRET_ACCESS_KEY=               # [S] legacy: spaces.s3overrides.secretAccessKey

# --- Staff bootstrap (loginStaff on an empty DB) -------------------------------------------------
ADMIN_EMAIL=support@switchfood.net  # legacy: admin.emailAddress
ADMIN_APP_TYPE=staff                # legacy: admin.appType
ADMIN_STAFF_TYPE=Admin              # legacy: admin.adminStaffType
STAFF_ROLE_NAME=Staff               # legacy: admin.roleName

# --- Dispatch worker (chooseDriver job) ---------------------------------------------------------
DISPATCH_WORKER_ENABLED=true        # false for canary step 1 (plan §10)
AGENDA_COLLECTION=agendaJobs
AGENDA_PROCESS_EVERY_MS=5000        # Agenda 4 default
AGENDA_LOCK_LIFETIME_MS=600000      # Agenda 4 default

# --- Borrowed production accounts (staging only) -------------------------------------------------
SHARED_PROD_CREDENTIALS=            # staging: mail,sms,maps,s3 = production accounts it may use, each
                                    # fenced (allowlists, own bucket). Refused in every other APP_ENV.

# --- Secrets plumbing ---------------------------------------------------------------------------
SECRETS_SOURCE=none                 # none | gcp (staging/production)
# SECRETS_PROJECT=
# SECRETS_NAME=switch-server-env
# SECRETS_VERSION=                  # pinned number, never "latest"
