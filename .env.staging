# Staging, NON-secret configuration (committed). Separate GCP project and Atlas cluster (OD-1).
# Secrets come from Secret Manager (`switch-server-env` in SECRETS_PROJECT, pinned by
# SECRETS_VERSION); `pnpm staging:secret` adds a version. Setup and deploys: docs/05-staging.md.
# The deploy workflow refuses to run while this file doesn't match the staging project.
LOG_LEVEL=debug
PARSE_APP_NAME=Switch
PARSE_APP_ID=switchApp
# The staging App Engine URL: https:// + `gcloud app describe --format='value(defaultHostname)'`.
# Never a switchfood.net host (the prod-leak guard refuses it).
PARSE_PUBLIC_SERVER_URL=https://switchfood-staging.oa.r.appspot.com
# The master key only works from the instance itself. Parse Dashboard from your IP needs
# TRUST_PROXY measured first (plan P4-3, docs/05-staging.md).
MASTER_KEY_IPS=127.0.0.1,::1
# App Engine's proxy reaches the server from loopback: the client address is this header.
CLIENT_IP_HEADER=x-appengine-user-ip
GOOGLE_CLIENT_ID=121610801380-ouhdb4ogsuoervpqaq407fhn4ccobcp0.apps.googleusercontent.com
FACEBOOK_APP_IDS=3475273352569710
APPLE_CLIENT_IDS=com.switchapp.food,com.switchapp.driver,com.switchapp.manager
# Production accounts staging borrows until it has its own, each fenced by the prod-leak guard:
# mail and SMS only reach the allowlists below, files go to the staging bucket, map lookups are
# read-only. Remove a name once staging has its own credentials for it.
SHARED_PROD_CREDENTIALS=mail,sms,maps,s3
MAIL_DRIVER=allowlist
MAIL_FROM=no-reply@switchfood.net
# Testers' addresses, comma-separated. Every other email is only logged (redacted).
MAIL_ALLOWLIST=dev.kfek@gmail.com
# Dedicated staging Firebase project: pushes only reach app builds registered with it.
PUSH_DRIVER=fcm
# Dedicated staging Pusher app. App id and key are public (the apps ship the key); the secret is
# in Secret Manager.
REALTIME_DRIVER=pusher
PUSHER_APP_ID=2196094
PUSHER_KEY=431b35358841665c3ed0
PUSHER_CLUSTER=eu
SMS_DRIVER=allowlist
SMS_ENDPOINT=https://es3.sms-algerie.com/api/json
# Testers' numbers, comma-separated, exactly as the apps send them (+213XXXXXXXXX, no spaces).
# Every other number only gets a logged fake SMS (no code is delivered).
SMS_PHONE_ALLOWLIST=+213771063732,+213778062991
SMS_MESSAGE_TEMPLATE=Your Switch code is: %CODE%
SMS_RETRIEVER_HASH_FOOD=euK5ZNhbO6h
SMS_RETRIEVER_HASH_DRIVER=oleQE6OQqru
SMS_RETRIEVER_HASH_MANAGER=KtjJ1xHgVtK
DISTANCE_DRIVER=google
FILES_DRIVER=s3
# The production Spaces account, its own bucket: staging never writes to or deletes from
# `switchfood` (the guard refuses that bucket).
S3_BUCKET=switchfood-staging
S3_BASE_URL=https://switchfood-staging.fra1.cdn.digitaloceanspaces.com
S3_ENDPOINT=https://fra1.digitaloceanspaces.com
S3_REGION=fra1
S3_FORCE_PATH_STYLE=false
S3_CACHE_CONTROL=public, max-age=31536000
ADMIN_EMAIL=support@switchfood.net
ADMIN_APP_TYPE=staff
ADMIN_STAFF_TYPE=Admin
STAFF_ROLE_NAME=Staff
DISPATCH_WORKER_ENABLED=true
AGENDA_COLLECTION=agendaJobs
AGENDA_PROCESS_EVERY_MS=5000
AGENDA_LOCK_LIFETIME_MS=600000
SECRETS_SOURCE=gcp
# The staging GCP project id (it must match the GCP_PROJECT_ID repository variable).
SECRETS_PROJECT=switchfood-staging
SECRETS_NAME=switch-server-staging-env
# The pinned secret version. `pnpm staging:secret` writes it after adding one; commit it to deploy.
SECRETS_VERSION=1
